{
  "name": "codeisotope",
  "version": "0.5.0",
  "description": "Finds the mature, battle-tested libraries your AI-written codebase reinvented by hand, grades the dependencies it already has, and reports what is missing. JavaScript, Python, Rust and Go.",
  "keywords": [
    "ai",
    "codebase",
    "dependencies",
    "oss",
    "github",
    "claude-code",
    "opencode",
    "cursor",
    "python",
    "rust",
    "golang",
    "supply-chain"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "codeisotope": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HARRY5432/CodeIsotope.git"
  },
  "homepage": "https://github.com/HARRY5432/CodeIsotope#readme",
  "bugs": {
    "url": "https://github.com/HARRY5432/CodeIsotope/issues"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "dev": "node src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {}
}
